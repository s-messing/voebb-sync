# VOEBB library account (https://www.voebb.de)
VOEBB_USER=
VOEBB_PASSWORD=

# Calendar target for `voebb-cli sync-calendar` - any CalDAV server.
# CALDAV_URL is used verbatim: point it at your server's DAV root.
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=

# Nextcloud users can set these instead: a bare host is completed to
# .../remote.php/dav automatically. Use an app password
# (Settings > Security > Create new app password), not your login password.
NEXTCLOUD_URL=https://cloud.example.de
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=

# Optional. Calendar to write into (created if missing) and how many days
# before the due date the reminder fires.
VOEBB_CALENDAR_NAME=VÖBB Leihfristen
VOEBB_ALARM_DAYS=3

# Optional. Namespaces this account's calendar events so several people can
# share one calendar without their syncs deleting each other's entries.
# Defaults to a short salted hash of VOEBB_USER; set a readable label if you prefer.
VOEBB_ACCOUNT=
