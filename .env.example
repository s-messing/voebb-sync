# VOEBB library account (https://www.voebb.de)
VOEBB_USER=
VOEBB_PASSWORD=

# Nextcloud target for `voebb sync-calendar`.
# Point at the DAV root; the client discovers the rest.
NEXTCLOUD_URL=https://cloud.example.de/remote.php/dav
NEXTCLOUD_USER=
# Settings > Security > Create new app password (not your login password)
NEXTCLOUD_APP_PASSWORD=

# Optional. Calendar to write into (created if missing) and how many days
# before the due date the reminder fires.
VOEBB_CALENDAR_NAME=VÖBB Leihfristen
VOEBB_ALARM_DAYS=3

# Optional. Namespaces this account's calendar events so several people can
# share one calendar without their syncs deleting each other's entries.
# Defaults to a short hash of VOEBB_USER; set a readable label if you prefer.
VOEBB_ACCOUNT=
