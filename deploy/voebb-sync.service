# Install into ~/.config/systemd/user/ together with the timer:
#
#   install -d ~/.config/voebb
#   install -m 644 deploy/compose.yaml ~/.config/voebb/
#   install -m 755 deploy/voebb-sync   ~/.config/voebb/
#   cp .env ~/.config/voebb/.env && chmod 600 ~/.config/voebb/.env
#   install -m 644 deploy/voebb-sync.service deploy/voebb-sync.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now voebb-sync.timer
#
# The image is private, so the engine needs a registry login first:
#   docker login ghcr.io -u <github-user>   # or: podman login ghcr.io -u ...

[Unit]
Description=Sync VOEBB loans to the Nextcloud calendar
Documentation=https://github.com/s-messing/voebb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Everything the run needs - compose file, .env, the wrapper - is in here.
WorkingDirectory=%h/.config/voebb
ExecStart=%h/.config/voebb/voebb-sync

# Force one engine instead of letting the wrapper choose:
# Environment=VOEBB_COMPOSE=podman compose

# A run that hangs must not sit on the timer until tomorrow.
TimeoutStartSec=15min
SyslogIdentifier=voebb-sync
