#!/bin/sh
# One sync, through whichever container engine this host actually has.
#
# Engine order: $VOEBB_COMPOSE if set, then docker, then podman. Docker is
# probed with `docker info` rather than `command -v`, because an installed
# CLI whose daemon socket is not readable is the normal state right after
# installing docker, and it fails at run time instead of at detection time.
set -eu

cd "${VOEBB_DIR:-$(dirname "$0")}"

engine() {
    if [ -n "${VOEBB_COMPOSE:-}" ]; then
        printf '%s' "$VOEBB_COMPOSE"
    elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        printf 'docker compose'
    elif command -v podman >/dev/null 2>&1; then
        printf 'podman compose'
    else
        echo "voebb-sync: no usable engine (docker daemon unreachable, no podman)" >&2
        exit 1
    fi
}

compose=$(engine)
echo "voebb-sync: $compose in $PWD"

# Best effort: an unreachable registry must not fail a sync that the local
# image could have completed.
$compose pull --quiet voebb || echo "voebb-sync: pull failed, using local image" >&2

exec $compose up --abort-on-container-exit --exit-code-from voebb
