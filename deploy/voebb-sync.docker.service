# The docker variant. Pick one, install it as voebb-sync.service:
#
#   sudo install -d -m 750 /srv/voebb
#   sudo install -m 644 deploy/compose.yaml /srv/voebb/
#   sudo install -m 600 .env /srv/voebb/.env
#   sudo install -m 644 deploy/voebb-sync.docker.service /etc/systemd/system/voebb-sync.service
#   sudo install -m 644 deploy/voebb-sync.timer           /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now voebb-sync.timer
#
# The image is private. Log in ONCE, as root and with the same authfile the
# unit uses below - a login in your own account is not visible to it, and one
# without the authfile lands on tmpfs and is lost at the next reboot:
#   sudo env DOCKER_CONFIG=/srv/voebb/docker \
#     docker login ghcr.io -u <github-user>    # PAT with read:packages

[Unit]
Description=Sync VOEBB loans to the Nextcloud calendar
Documentation=https://github.com/s-messing/voebb
After=network-online.target
Wants=network-online.target
# Wants, not Requires: if the daemon is down the run fails on its own and says
# so, rather than the timer being torn down with it.
After=docker.service
Wants=docker.service

[Service]
Type=oneshot

# Compose file and .env both live here.
WorkingDirectory=/srv/voebb

# Keep the registry credentials with the rest of the service rather than in
# /root/.docker. DOCKER_CONFIG names a directory, not a file.
Environment=DOCKER_CONFIG=/srv/voebb/docker

# Leading "-": an unreachable registry must not fail a sync that the local
# image could have completed.
ExecStartPre=-/usr/bin/docker compose pull --quiet voebb
# --exit-code-from matters: a plain `compose up` exits 0 even when the
# container failed, which would report every broken sync as a success.
ExecStart=/usr/bin/docker compose up --abort-on-container-exit --exit-code-from voebb

# A run that hangs must not sit on the timer until tomorrow.
TimeoutStartSec=15min
SyslogIdentifier=voebb-sync
